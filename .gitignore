# Dependencies
node_modules/
dist/
dist-electron/
release/
frontend/dist/
*.local

# Python — global catch-all (covers backend/, scripts, anywhere)
__pycache__/
*.pyc
*.pyo
*.egg-info/
backend/venv/
backend/.venv/
backend/.mypy_cache/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/

# Database files (user-specific, never commit)
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
# DB backups/snapshots (e.g. jarvis.db.backup-kokoro-20260715-172614) — the
# `*.db` rule above only matches names ENDING in .db, so backups slip through.
backend/*.db.backup*
backend/*.db.bak

# Environment variables (SECRETS — never commit)
.env
backend/.env
!.env.example

# Electron
out/

# OS
.DS_Store
Thumbs.db
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.tsbuildinfo

# Claude Code (commit .claude/skills, keep machine-local settings out)
.claude/settings.local.json

# Antigravity IDE (workspace customizations)
.agents/

# Qdrant data (embedded local disk mode + Docker volume)
qdrant_storage/
qdrant_data/
backend/qdrant_data/

# Voice models (large binary files)
backend/voices/*.onnx
backend/voices/*.onnx.json

# FastEmbed model cache (downloaded at runtime)
backend/local_cache/

# Debug/utility scripts (one-off, not part of the app)
backend/check_contacts.py
backend/delete_phantom.py
backend/verify_db.py
backend/migrate_*.py

# Compiled output of frontend/src/lib/__verify__ (see its header for how it is
# run). Build artefact, never committed.
.verify/
