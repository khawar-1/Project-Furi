# =============================================================================
# JARVIS OS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Which LLM provider to use: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini

# Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-2.0-flash

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model name
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# BROWSER VISION (multi-key rotation, optional)
# =============================================================================
# The browser agent's vision channel rotates through every key below; a key that
# hits its quota/rate limit cools down and the next is tried, and when all are
# spent the browser falls back to DOM-text (it never fails). Groq is tried before
# Gemini. Turn vision ON in Settings → Browser to use these. Comma-separate keys.
VISION_GROQ_API_KEYS=
VISION_GEMINI_API_KEYS=
VISION_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_MODEL=gemini-2.0-flash
VISION_KEY_COOLDOWN_SECONDS=900

# OpenRouter API key (get from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model name
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=llama3.2

# =============================================================================
# DATABASE
# =============================================================================
# SQLite database file path (relative to backend directory)
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# =============================================================================
# QDRANT (Vector Database)
# =============================================================================
# Qdrant host (Docker container default)
QDRANT_HOST=localhost

# Qdrant port
QDRANT_PORT=6333

# Qdrant collection name for semantic memory
QDRANT_COLLECTION=jarvis_memory

# =============================================================================
# BACKEND
# =============================================================================
# FastAPI server host
BACKEND_HOST=127.0.0.1

# FastAPI server port
BACKEND_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# GOOGLE INTEGRATION (Phase 5 — Email + Calendar)
# =============================================================================
# OAuth client for the installed-app loopback flow. In Google Cloud Console:
# create a project, enable the Gmail API and Google Calendar API, then create
# an OAuth client of type "Desktop app" and paste its credentials here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the sign-in token is stored. Empty = ~/.jarvis/google_token.json
# (outside the repo — never commit a token file).
GOOGLE_TOKEN_PATH=

# =============================================================================
# WEB SEARCH (Phase 6)
# =============================================================================
# Optional. When set, web_search uses the Tavily API (built for LLM agents —
# returns clean extracted page content, reliable) as the primary provider, with
# the keyless DuckDuckGo scrapers as automatic fallback. Blank = DuckDuckGo only
# (works with no signup, but scraping is fragile). Free key at https://tavily.com
TAVILY_API_KEY=

# Optional but RECOMMENDED. Google Programmable Search (Custom Search JSON API).
# When BOTH are set, web_search PREFERS Google and falls through to Tavily →
# DuckDuckGo when it returns nothing.
#
# WHY IT IS WORTH THE FIVE MINUTES (measured 2026-08-02). Google is the only
# provider in the chain that SPELL-CORRECTS a query — "showing results for junaid
# jamshed" — and that is exactly what a misheard site name needs. Voice is a
# first-class input here, and no speech model can spell a proper noun it has
# never seen, so "the domain in the goal is misspelled" is an EXPECTED input to
# the browser stack. Measured: searching the misheard "junetjamshed" on Tavily
# put the real site 7th of 8 rows; "amazn" did not return amazon.com at all.
# browser/did_you_mean.py compensates for that in code, but a spell-correcting
# index is the better fix and it also makes "latest / newest / today" facts
# fresher (2026-07-25: Tavily reported a stale episode number).
#
# Free tier: 100 queries/day. Create a key at
#   https://developers.google.com/custom-search/v1/introduction
# and an engine (set it to "search the entire web") at
#   https://programmablesearchengine.google.com   — CX is the engine id.
# Direct google.com/search scraping is deliberately NOT used: it violates
# Google's ToS and is CAPTCHA-blocked for automated clients.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# =============================================================================
# VOICE (Phase 6)
# =============================================================================
# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Piper voice model path
PIPER_VOICE_PATH=./voices/en_US-amy-medium.onnx

# =============================================================================
# SUPABASE AUTH (Optional — local-first setup works without this)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# =============================================================================
# APP
# =============================================================================
# Application version
APP_VERSION=0.1.0

# Debug mode
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
