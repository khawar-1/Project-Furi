# =============================================================================
# JARVIS OS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Which LLM provider to use: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini

# Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-2.0-flash

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model name
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# BROWSER VISION (multi-key rotation, optional)
# =============================================================================
# The browser agent's vision channel rotates through every key below; a key that
# hits its quota/rate limit cools down and the next is tried, and when all are
# spent the browser falls back to DOM-text (it never fails). Groq is tried before
# Gemini. Turn vision ON in Settings → Browser to use these. Comma-separate keys.
VISION_GROQ_API_KEYS=
VISION_GEMINI_API_KEYS=
VISION_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_MODEL=gemini-2.0-flash
VISION_KEY_COOLDOWN_SECONDS=900

# OpenRouter API key (get from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model name
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=llama3.2

# =============================================================================
# DATABASE
# =============================================================================
# SQLite database file path (relative to backend directory)
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# =============================================================================
# QDRANT (Vector Database)
# =============================================================================
# Qdrant host (Docker container default)
QDRANT_HOST=localhost

# Qdrant port
QDRANT_PORT=6333

# Qdrant collection name for semantic memory
QDRANT_COLLECTION=jarvis_memory

# =============================================================================
# BACKEND
# =============================================================================
# FastAPI server host
BACKEND_HOST=127.0.0.1

# FastAPI server port
BACKEND_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# GOOGLE INTEGRATION (Phase 5 — Email + Calendar)
# =============================================================================
# OAuth client for the installed-app loopback flow. In Google Cloud Console:
# create a project, enable the Gmail API and Google Calendar API, then create
# an OAuth client of type "Desktop app" and paste its credentials here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the sign-in token is stored. Empty = ~/.jarvis/google_token.json
# (outside the repo — never commit a token file).
GOOGLE_TOKEN_PATH=

# =============================================================================
# WEB SEARCH (Phase 6)
# =============================================================================
# Optional. When set, web_search uses the Tavily API (built for LLM agents —
# returns clean extracted page content, reliable) as the primary provider, with
# the keyless DuckDuckGo scrapers as automatic fallback. Blank = DuckDuckGo only
# (works with no signup, but scraping is fragile). Free key at https://tavily.com
TAVILY_API_KEY=

# ⚠️ LEAVE BLANK ON A NEW INSTALL — Google Custom Search is a DEAD END, verified
# against Google's own docs on 2026-08-02 while actually trying to set one up:
#
#   * "Search the entire web" was DISCONTINUED (March 2026). The toggle now says
#     "This feature is being deprecated and can no longer be enabled", so a new
#     Programmable Search Engine can only search a list of sites you name — which
#     is useless for the thing that made this attractive (finding the OFFICIAL
#     site for a misspelled/misheard brand anywhere on the web).
#   * The Custom Search JSON API is "closed to new customers" — a new key cannot
#     be obtained regardless.
#   * It RETIRES 1 January 2027. Google's suggested replacement is Vertex AI
#     Search (~$2 per 1k queries, up to 50 domains), a different product with a
#     different shape — not a drop-in for "search the web".
#
# The code path is KEPT deliberately: an engine created before the cut still
# works until retirement, and both blank means `_google_cse_search` returns []
# without making a request, so a default install never touches it. Recorded here
# so nobody repeats the trip.
#
# What actually covers the misheard-domain case is in code, and measured:
# browser/did_you_mean.py reads the corrected name out of the search results'
# own TITLES and DNS-verifies the host it forms (amazn -> amazon.com, which no
# provider in the chain returns directly).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# =============================================================================
# VOICE (Phase 6)
# =============================================================================
# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Piper voice model path
PIPER_VOICE_PATH=./voices/en_US-amy-medium.onnx

# =============================================================================
# SUPABASE AUTH (Optional — local-first setup works without this)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# =============================================================================
# APP
# =============================================================================
# Application version
APP_VERSION=0.1.0

# Debug mode
DEBUG=true

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
